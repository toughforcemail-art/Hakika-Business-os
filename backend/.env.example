# Server-only Supabase configuration for backend services and Edge Functions.
# Never commit real values. Do not put service-role keys in frontend/.env.local.
SUPABASE_URL=https://upvupkuokinwqwsfxyxy.supabase.co
SUPABASE_PROJECT_REF=upvupkuokinwqwsfxyxy
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=replace_only_in_local_secret_store
# Server-only Africa's Talking SMS/WhatsApp configuration. Never use NEXT_PUBLIC_ prefixes.
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_ENVIRONMENT=sandbox
# Generated in Supabase Auth Hooks; never commit the real value.
SEND_SMS_HOOK_SECRET=v1,whsec_replace_in_secret_store
# High-entropy backend-only HMAC secret for app_mfa challenge and session hashes.
HAKIKA_APP_MFA_HMAC_SECRET=replace_in_backend_secret_store
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_KEY_PREFIX=hakika
