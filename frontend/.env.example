# Browser-safe Supabase configuration for Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://upvupkuokinwqwsfxyxy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Server-only Redis values. Never rename these with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_KEY_PREFIX=hakika
# Non-secret server-side URL for the backend app_mfa service.
BACKEND_INTERNAL_URL=http://localhost:5000
