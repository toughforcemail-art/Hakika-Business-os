{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "lucide-react": ["./src/compat/lucide-react"],
      "react-router-dom": ["./src/compat/react-router-dom"]
      ,"framer-motion": ["./src/compat/framer-motion"],
      "@dnd-kit/core": ["./src/compat/dnd-kit-core"],
      "@dnd-kit/sortable": ["./src/compat/dnd-kit-sortable"],
      "@dnd-kit/utilities": ["./src/compat/dnd-kit-utilities"],
      "imagekitio-react": ["./src/compat/imagekitio-react"],
      "jspdf": ["./src/compat/jspdf"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev/types/**/*.ts"
  ]
}
